{
  "name": "application-mathematiques",
  "productName": "Application Mathématiques",
  "version": "0.1.1",
  "description": "Application PC hors-ligne pour la lecture de cours et de notions mathématiques (agrégation externe)",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "CeciestuntestKST",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --dir",
    "dist:installer": "electron-builder",
    "postinstall": "node scripts/copy-vendor.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "katex": "^0.16.11",
    "pdfjs-dist": "^3.11.174"
  },
  "build": {
    "appId": "fr.agreg.maths.app",
    "productName": "Application Mathématiques",
    "npmRebuild": false,
    "icon": "assets/icons/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "assets/**/*",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "publish": {
    "provider": "github",
    "owner": "CeciestuntestKST",
    "repo": "Application-Math-matiques"
  },
  "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
